{
  "name": "phishdojo",
  "version": "0.1.0",
  "private": true,
  "description": "PhishDojo : vérifier, s'entraîner, signaler, observer. Détection du phishing et des arnaques au mobile money (première édition : Sénégal).",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:sql": "bash scripts/test-sql.sh",
    "test:e2e": "playwright test",
    "verifier": "npm test && npm run test:sql && npm run test:e2e",
    "serve": "node tests/e2e/serveur.js",
    "rappel": "node scripts/avant-ouverture.js",
    "postinstall": "node scripts/vendre.js",
    "vendre": "node scripts/vendre.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/doto": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tesseract.js-data/fra": "1.0.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  }
}
